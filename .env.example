# PostgreSQL (placeholder values only)
DATABASE_URL=postgresql+psycopg://social_analytics:change-me@localhost:5432/social_analytics

# X API
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_QUERY=
X_MAX_RESULTS=100
X_STREAM_ENABLED=false
X_SEARCH_INTERVAL_SECONDS=60

# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Analytics
NLP_BATCH_SIZE=16
NLP_MODEL_DOWNLOAD_ENABLED=false
GRAPH_INTERVAL_SECONDS=300
TREND_INTERVAL_SECONDS=900
SENTIMENT_WINDOW_MINUTES=60

