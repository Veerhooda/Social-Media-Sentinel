# PostgreSQL (placeholder values only)
DATABASE_URL=postgresql+psycopg://social_analytics:change-me@localhost:5432/social_analytics

# Telegram MTProto (authorized public-channel access only)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# Public channels collected by the scheduler (comma-separated usernames). More can be added in the UI.
TELEGRAM_CHANNELS=
TELEGRAM_POLL_INTERVAL_SECONDS=120
TELEGRAM_MAX_MESSAGES_PER_POLL=100

# X API
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_QUERY=
X_MAX_RESULTS=100
X_STREAM_ENABLED=false
X_SEARCH_INTERVAL_SECONDS=60
X_MAX_PAGES_PER_RUN=1

# YouTube (polling-based comment ingestion; API key only, never committed with values)
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=
# Extra videos to poll (comma-separated ids or URLs). More can be added in the UI.
YOUTUBE_VIDEO_IDS=
YOUTUBE_MAX_RESULTS=50
YOUTUBE_MAX_PAGES=2
YOUTUBE_MAX_API_CALLS=10
YOUTUBE_POLL_INTERVAL_SECONDS=60

# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Analytics
NLP_BATCH_SIZE=16
NLP_MODEL_DOWNLOAD_ENABLED=false
NLP_PROCESSING_INTERVAL_SECONDS=30
GRAPH_INTERVAL_SECONDS=300
TREND_INTERVAL_SECONDS=900
TREND_WINDOW_MINUTES=15
TREND_MIN_DOCUMENTS=10
TREND_EMBEDDING_MODEL=all-MiniLM-L12-v2
TREND_MODEL_DOWNLOAD_ENABLED=false
TREND_TOPIC_CENTROID_SIMILARITY_THRESHOLD=0.70
SENTIMENT_WINDOW_MINUTES=60
SCHEDULER_ENABLED=false
SCHEDULER_TICK_SECONDS=1
ANALYTICS_JOB_BATCH_SIZE=100
ANALYTICS_INCLUDE_REPLAY=false

# Audience Lab (Muse Spark via Meta Model API, OpenAI-compatible; https://dev.meta.ai/docs)
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
AUDIENCE_LAB_MODEL=muse-spark-1.3-contributor
AUDIENCE_LAB_REASONING_EFFORT=
AUDIENCE_LAB_FAST_REASONING_EFFORT=low
AUDIENCE_LAB_TIMEOUT_SECONDS=300
AUDIENCE_LAB_MAX_PARALLEL_AGENTS=8
AUDIENCE_LAB_ASSIGN_BATCH=40
AUDIENCE_LAB_MIN_SEGMENTS=3
AUDIENCE_LAB_MAX_SEGMENTS=8
